[Unit]
Description=Finance standby SQLite API
After=network.target

[Service]
Type=simple
User=finance-db
Group=finance-db
ExecStart=/usr/bin/python3 /opt/finance-standby/db_api.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/finance-standby

[Install]
WantedBy=multi-user.target
