{
  "name": "bolccop-meeting-desktop",
  "version": "1.2.0",
  "private": true,
  "description": "Bread of Life Church Windows meeting client",
  "author": "BOLCCOP",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test policy.test.cjs agendaFolder.test.cjs",
    "smoke": "node smoke.cjs",
    "pack": "node build-zip.cjs",
    "pack:exe": "node build-zip.cjs --exe",
    "pack:setup": "node build-zip.cjs --setup"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "playwright": "^1.58.0"
  },
  "build": {
    "appId": "org.bolccop.meeting",
    "productName": "BOLCCOP Meeting Client",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "policy.cjs",
      "picker.html",
      "picker.cjs",
      "picker-preload.cjs",
      "agendaFolder.cjs"
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.png",
      "signAndEditExecutable": true
    },
    "compression": "maximum",
    "electronLanguages": [
      "zh-TW",
      "zh-CN",
      "en-US"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BOLCCOP Meeting Client",
      "deleteAppDataOnUninstall": false,
      "language": "1028",
      "installerLanguages": [
        "zh_TW"
      ],
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  }
}
